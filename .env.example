JARVIS_ENVIRONMENT=development
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
JARVIS_OLLAMA_HOST=http://127.0.0.1:11434
JARVIS_LOG_LEVEL=INFO
JARVIS_DATA_DIR=./data
# Cloud credentials are intentionally not required in Phase 01.
# JARVIS_OPENAI_API_KEY=
# JARVIS_GEMINI_API_KEY=

# Voice & audio subsystem (Phase 07). Disabled by default; privacy-first.
# JARVIS_VOICE__ENABLED=false
# JARVIS_VOICE__PUSH_TO_TALK=true
# JARVIS_VOICE__STARTUP_SPEECH=false
# JARVIS_VOICE__STARTUP_PHRASE=JARVIS is ready and listening.
# JARVIS_VOICE__STT_MODEL=tiny
# JARVIS_VOICE__STT_MODEL_DIR=./models/stt
# JARVIS_VOICE__TTS_MODEL=voice.onnx
# JARVIS_VOICE__TTS_MODEL_DIR=./models/tts

# Calendar, timetable & personal workflows (Phase 09). Disabled by default.
# JARVIS_CALENDAR__ENABLED=false
# JARVIS_CALENDAR__TIMEZONE=UTC
# JARVIS_CALENDAR__SCHEDULER_ENABLED=true
# JARVIS_CALENDAR__MAX_EVENTS_RETURNED=128
# JARVIS_CALENDAR__MAX_OCCURRENCES_PER_QUERY=256
# JARVIS_CALENDAR__MAX_WORKFLOW_STEPS=32
# JARVIS_CALENDAR__MAX_WORKFLOW_DEPTH=8
